{
  "name": "@prf/ui",
  "version": "0.7.1",
  "private": true,
  "type": "module",
  "description": "PRF Design System — общие токены и компоненты для office/web/pos/mobile. Канон — shop.",
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens": {
      "types": "./src/tokens.ts",
      "default": "./src/tokens.ts"
    },
    "./styles.css": "./src/styles/index.css",
    "./tokens.css": "./src/styles/tokens.css"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "tokens": "node scripts/tokens.mjs",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/tokens.mjs --check && npm run typecheck && prettier --check ."
  }
}
